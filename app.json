{
  "expo": {
    "name": "AcademyPro",
    "slug": "picklepro-mobile",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "academypro",
    "splash": {
      "backgroundColor": "#05091F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "16",
      "googleServicesFile": "./ios/GoogleService-Info.plist",
      "bundleIdentifier": "com.picklepro.mobile",
      "icon": "./assets/images/icon.png",
      "associatedDomains": [
        "applinks:pickleballhero.app"
      ],
      "config": {
        "googleMapsApiKey": "AIzaSyAMNdMtfFdyekAB1VwDORs9Fesl41JUajg"
      },
      "infoPlist": {
        "CFBundleDisplayName": "AcademyPro",
        "NSUserTrackingUsageDescription": "We use tracking to provide personalized coaching recommendations and improve your training experience."
      }
    },
    "android": {
      "backgroundColor": "#05091F",
      "package": "com.picklepro.mobile",
      "versionCode": 16,
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#05091F"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "academypro"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAMNdMtfFdyekAB1VwDORs9Fesl41JUajg"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "googleServicesFile": "./android/app/google-services.json"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.140906288105-akv9va24o1jggs7g23bjciagglel55h8"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d9a056b2-6df1-44d9-bf47-7d928a2029b2"
      }
    }
  }
}
